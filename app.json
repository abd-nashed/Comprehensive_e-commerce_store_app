{
  "expo": {
    "name": "متجري",
    "slug": "marketAppMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marketappmobile",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FF6B00"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.marketAppMobile",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "التطبيق يحتاج الوصول إلى صورك لرفع صور المنتجات والأقسام.",
          "cameraPermission": "التطبيق يحتاج الوصول إلى الكاميرا لالتقاط صور المنتجات."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6B00",
          "image": "./assets/images/icon.png",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1bd3fbf6-733a-4a32-ab4e-b514fabf9887"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1bd3fbf6-733a-4a32-ab4e-b514fabf9887"
    },
    "ios": {}
  }
}
